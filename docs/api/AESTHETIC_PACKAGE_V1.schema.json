{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Click2Cloud Aesthetic package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "compatibleApiVersion",
    "tokens"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "compatibleApiVersion": {
      "const": "1.0"
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color.background": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$type",
            "$value"
          ],
          "properties": {
            "$type": {
              "const": "color"
            },
            "$value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "light",
                "dark"
              ],
              "properties": {
                "light": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                },
                "dark": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                }
              }
            }
          }
        },
        "color.surface": {
          "type": "object",
