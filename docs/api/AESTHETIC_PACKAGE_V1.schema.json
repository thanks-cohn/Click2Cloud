              "properties": {
                "light": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                },
                "dark": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                }
              }
            }
          }
        },
        "color.raised": {
          "type": "object",
          "additionalProperties": false,
