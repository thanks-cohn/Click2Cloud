  "stressScenarios": [
    {
      "id": "empty",
      "description": "0 manually saved destinations, Depth OFF; single default root should be actionable"
    },
    {
      "id": "page-boundary",
      "description": "Programmatically generate 21 Simple and 21 Narrow distinct records to test 20/page pagination"
    },
    {
      "id": "large-manager",
      "description": "Generate 100 user-created Narrow destinations and full ancestor aliases for independent menu-config restore"
    },
    {
      "id": "deep-index",
      "description": "Generate 5000 folder nodes across 2 buckets including 11-level chains and repeated sibling names; assert bounded display and completeness notice"
    },
    {
      "id": "collision",
      "description": "Two different Cloudflare accounts share a bucket/folder display name; route ID must include exact account identity"
    }
  ]
