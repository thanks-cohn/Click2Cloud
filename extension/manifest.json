{
  "manifest_version": 3,
  "icons": {"16": "extension/icons/redown-16.png", "32": "extension/icons/redown-32.png", "48": "extension/icons/redown-48.png", "128": "extension/icons/redown-128.png"},
  "name": "REDOWN",
  "short_name": "REDOWN",
  "version": "0.3.32.6",
  "version_name": "0.3.32.6",
  "description": "REDOWN \u2014 cloud Explorer and secure V3+1 native save destinations.",
  "permissions": [
    "contextMenus",
    "storage",
    "identity",
    "alarms",
    "activeTab",
    "sidePanel",
    "notifications",
    "webNavigation",
    "downloads"
  ],
  "optional_permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "extension/background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "REDOWN \u2014 Remotes",
    "default_icon": {"16": "extension/icons/redown-16.png", "32": "extension/icons/redown-32.png", "48": "extension/icons/redown-48.png", "128": "extension/icons/redown-128.png"}
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": "",
  "oauth2": {
    "client_id": "763628402500-nnvp04squ9dfpbsvp64egvgkhddlb0ff.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.file"]
  },
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://*.1drv.com/*",
    "https://*.onedrive.com/*",
    "https://*.my.microsoftpersonalcontent.com/*",
    "https://*.sharepoint.com/*",
    "https://*.sharepoint-df.com/*",
    "https://api.dropboxapi.com/*",
    "https://content.dropboxapi.com/*",
    "https://api.cloudflare.com/*",
    "https://dash.cloudflare.com/*",
    "https://*.workers.dev/*",
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "screenshot.capture.alt-q": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "Capture a screenshot to cloud"
    },
    "screenshot.capture.ctrl-shift-y": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "MacCtrl+Shift+Y" },
      "description": "Capture a screenshot to cloud (second shortcut)"
    },
    "shelf.history.toggle": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Open or close Shelf History"
    },
    "shelf.explorer.search": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Open File Explorer and focus filename search"
    }
  },
  "side_panel": {
    "default_path": "extension/app.html"
  },
  "web_accessible_resources": [{
    "resources": ["extension/icons/redown-console-r.png"],
    "matches": ["https://*/*", "http://*/*"]
  }],
  "content_scripts": [{
    "matches": ["https://*/*", "http://*/*"],
    "js": ["extension/projectile.js", "extension/console-save-notice.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
