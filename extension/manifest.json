{
  "manifest_version": 3,
  "name": "Click2Cloud",
  "version": "0.3.15",
  "description": "Click2Cloud \u2014 cloud Explorer and secure V3+1 native save destinations.",
  "permissions": [
    "contextMenus",
    "storage",
    "identity",
    "alarms",
    "activeTab",
    "sidePanel",
    "notifications",
    "webNavigation"
  ],
  "background": {
    "service_worker": "extension/background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Click2Cloud \u2014 Remotes"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": "",
  "host_permissions": [
    "https://api.cloudflare.com/*",
    "https://dash.cloudflare.com/*",
    "https://*.workers.dev/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "side_panel": {
    "default_path": "extension/app.html"
  }
}
